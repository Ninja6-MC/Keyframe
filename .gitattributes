# Line-ending policy per N6-CI-04
*.sh            text eol=lf
*.bat           text eol=crlf
*.ps1           text eol=crlf
*.svg           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.mjs           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
LICENSE         text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.gitignore      text eol=lf

# Binaries
*.png           binary
*.zip           binary
