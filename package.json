{
  "name": "@ninja6-mc/keyframe",
  "version": "0.1.0-alpha.1",
  "description": "The cinematic trailer aesthetic for Minecraft, authored in infinite-resolution vector masters.",
  "type": "module",
  "main": "tools/build.mjs",
  "scripts": {
    "build": "node tools/build.mjs --res 512",
    "build:512": "node tools/build.mjs --res 512",
    "build:256": "node tools/build.mjs --res 256",
    "build:128": "node tools/build.mjs --res 128",
    "build:64": "node tools/build.mjs --res 64",
    "build:32": "node tools/build.mjs --res 32",
    "build:all": "node tools/build.mjs --all",
    "build:deploy": "node tools/build.mjs --res 512 --deploy",
    "build:all:deploy": "node tools/build.mjs --all --deploy",
    "export:icons": "node scripts/export-icons.mjs",
    "palette:inject": "node tools/lib/palette-injector.mjs",
    "sync:studio": "node tools/sync-studio.mjs",
    "sync:studio:watch": "node tools/sync-studio.mjs --watch",
    "test:palette": "node tools/test/palette-injector.test.mjs",
    "test:base-sync": "node tools/test/base-sync.test.mjs",
    "test:tiling-rules": "node tools/test/tiling-rules.test.mjs",
    "test:sync-studio": "node tools/test/sync-studio.test.mjs",
    "test:guardrails": "node tools/test/build-guardrails.test.mjs",
    "test:soil-palette-3d": "node tools/test/soil-palette-3d.test.mjs",
    "test:animation": "node tools/test-animation-packager.mjs",
    "test:tiling": "node tools/test-tiling.mjs",
    "test:tiling:render": "node tools/test-tiling.mjs --render",
    "test:shader-fixtures": "node tools/test-shader-fixtures.mjs",
    "test:shader-fixtures:render": "node tools/test-shader-fixtures.mjs --render",
    "test": "node tools/test-animation-packager.mjs && node tools/test/palette-injector.test.mjs && node tools/test/base-sync.test.mjs && node tools/test/tiling-rules.test.mjs && node tools/test/sync-studio.test.mjs && node tools/test/build-guardrails.test.mjs && node tools/test/soil-palette-3d.test.mjs && node tools/test-tiling.mjs && node tools/test-shader-fixtures.mjs"
  },
  "keywords": [
    "minecraft",
    "texture-pack",
    "resource-pack",
    "vector",
    "svg",
    "cinematic",
    "trailer",
    "keyframe",
    "ninja6"
  ],
  "author": "Ninja6-MC",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
